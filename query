import csv
from jobspy import scrape_jobs

jobs = scrape_jobs(
    site_name=["google"], #linkedin, zip_recruiter, indeed, glassdoor, google
    search_term="Data Engineer",
    google_search_term="",
    location="Germany",
    results_wanted=30,
    hours_old=72,
    country_indeed="",
    linkedin_fetch_description=True, # gets more info such as description, direct job url (slower)
    job_type="fulltime"

    # proxies=["208.195.175.46:65095", "208.195.175.45:65095", "localhost"],
)
print(f"Found {len(jobs)} jobs")
print(jobs.head())
jobs.to_csv("query_result/jobs.csv", quoting=csv.QUOTE_NONNUMERIC, escapechar="\\", index=False) # to_excel